# Database
POSTGRES_DB=pricepulse
POSTGRES_USER=pricepulse
POSTGRES_PASSWORD=pricepulse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=pricepulse
RABBITMQ_DEFAULT_PASS=pricepulse

# Telegram Bot (опционально)
# Если TELEGRAM_BOT_TOKEN указан - запускай с профилем bot
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_API_URL=your_api_here
FASTAPI_BASE_URL=http://localhost:8000
# Price checking interval (в секундах, минимум 60)
# Для разработки: 60 (1 минута)
# Для продакшена: 900 (15 минут)
PRICE_CHECK_INTERVAL=900

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Для разработки: DEBUG (показывает SQL запросы, детали)
# Для продакшена: INFO (только важная информация)
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://pricepulse.com

# Proxy rotation
PROXY_LIST=
PROXY_ROTATION_ENABLED=false
